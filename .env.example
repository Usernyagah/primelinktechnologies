# Firebase Configuration
# Get these from Firebase Console (Project Settings -> General -> Your Apps -> Web App)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=primelink-bd151
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary Configuration
# Get your cloud name from Cloudinary Dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# Create an "Unsigned" upload preset in Cloudinary Settings -> Upload
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# M-Pesa Daraja API (server-side — set in Vercel Environment Variables)
# Register at https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_ENV=sandbox
# Must be your live Vercel URL, e.g. https://primelinktechnologies.vercel.app/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/mpesa/callback

# Optional: Firebase service account JSON (single line) for auto-updating order status after payment
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
