rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog; only signed-in admins can write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Anyone can submit a contact message; only admins can read
    match /orders/{orderId} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['items', 'total', 'phone', 'createdAt'])
        && request.resource.data.total is number
        && request.resource.data.total >= 1
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.phone.size() <= 15
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow update: if request.auth == null
        && resource.data.status == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkoutRequestId']);
      allow read, update, delete: if request.auth != null;
    }

    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 255
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 1000;
      allow read, update, delete: if request.auth != null;
    }
  }
}
